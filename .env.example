PORT=4200
JWT_SECRET=sua_chave_jwt_aqui

# ── AWS (SQS + DynamoDB) ──────────────────────────────────────────────────────
QUEUE_PREFIX=oficina-mecanica-dev
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
DYNAMODB_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Capacidade da oficina (OS na fila + em execução). 0 = recusa tudo (demo de compensação)
MAX_ACTIVE_EXECUTIONS=10
OUTBOX_RETRY_INTERVAL_MS=10000

NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-exec-prod-service
LOG_LEVEL=info
