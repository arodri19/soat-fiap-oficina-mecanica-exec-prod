{
  "openapi": "3.0.3",
  "info": {
    "title": "Execution & Production Service — Oficina Mecânica (Fase 4)",
    "version": "4.0.0",
    "description": "Microsserviço de **Execução e Produção**: fila de execução das OS, diagnóstico e reparo. Participante da saga orquestrada pelo os-service: consome `StartExecution`/`CancelExecution` da fila SQS `<prefixo>-execution-commands` e publica `ExecutionQueued`, `ExecutionRejected`, `ExecutionStatusChanged`, `ExecutionCompleted`, `ExecutionFailed` e `ExecutionCancelled` na fila `<prefixo>-os-saga-replies`. Persistência em **DynamoDB**."
  },
  "servers": [
    {
      "url": "http://localhost:4200/api"
    }
  ],
  "tags": [
    {
      "name": "Fila de execução"
    },
    {
      "name": "Mecânico"
    },
    {
      "name": "Interno (service-to-service)"
    }
  ],
  "paths": {
    "/executions": {
      "get": {
        "tags": [
          "Fila de execução"
        ],
        "summary": "Lista execuções (opcionalmente por status)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "QUEUED",
                "DIAGNOSING",
                "REPAIRING",
                "COMPLETED",
                "FAILED",
                "CANCELLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Execuções",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Execution"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/executions/queue": {
      "get": {
        "tags": [
          "Fila de execução"
        ],
        "summary": "Fila de OS aguardando mecânico (FIFO)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Fila",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "type": "object",
                        "properties": {
                          "position": {
                            "type": "integer"
                          }
                        }
                      },
                      {
                        "$ref": "#/components/schemas/Execution"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/executions/{orderId}": {
      "get": {
        "tags": [
          "Fila de execução"
        ],
        "summary": "Execução de uma OS",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "orderId",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "responses": {
          "200": {
            "description": "Execução",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/executions/{orderId}/diagnosis/start": {
      "post": {
        "tags": [
          "Mecânico"
        ],
        "summary": "Inicia o diagnóstico (QUEUED → DIAGNOSING)",
        "description": "OS passa a EM_DIAGNOSTICO no os-service. Publica `ExecutionStatusChanged` na fila da saga (os-service).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "orderId",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mechanicName": {
                    "type": "string",
                    "example": "Roberto Silva"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execução atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Execução não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Transição inválida para o status atual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/executions/{orderId}/repair/start": {
      "post": {
        "tags": [
          "Mecânico"
        ],
        "summary": "Inicia o reparo (DIAGNOSING → REPAIRING)",
        "description": "OS passa a EM_EXECUCAO no os-service. Publica `ExecutionStatusChanged` na fila da saga (os-service).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "orderId",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "diagnosisNotes": {
                    "type": "string",
                    "example": "Pastilhas no limite, disco ok"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execução atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Execução não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Transição inválida para o status atual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/executions/{orderId}/complete": {
      "post": {
        "tags": [
          "Mecânico"
        ],
        "summary": "Finaliza o serviço (REPAIRING → COMPLETED)",
        "description": "OS passa a FINALIZADA e a saga é concluída. Publica `ExecutionCompleted` na fila da saga (os-service).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "orderId",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notes": {
                    "type": "string",
                    "example": "Teste de rodagem ok"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execução atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Execução não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Transição inválida para o status atual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/executions/{orderId}/fail": {
      "post": {
        "tags": [
          "Mecânico"
        ],
        "summary": "Reporta falha na execução",
        "description": "A saga compensa: estorno do pagamento (Mercado Pago) e OS CANCELADA. Publica `ExecutionFailed` na fila da saga (os-service).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "orderId",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "example": "Peça incompatível com o veículo"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execução atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Execução não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Transição inválida para o status atual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/executions/{orderId}": {
      "get": {
        "tags": [
          "Interno (service-to-service)"
        ],
        "summary": "Execução da OS para o os-service (REST síncrono, JWT role SERVICE)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "orderId",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "responses": {
          "200": {
            "description": "Execução",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Execution": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "example": "EXEC-42"
          },
          "orderId": {
            "type": "integer"
          },
          "sagaId": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "vehicle": {
            "type": "object",
            "properties": {
              "plate": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "serviceId": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "slaMinutes": {
                  "type": "integer"
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "estimatedMinutes": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "DIAGNOSING",
              "REPAIRING",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "mechanicName": {
            "type": "string",
            "nullable": true
          },
          "diagnosisNotes": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "timeline": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "by": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "queuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "nullable": true
          },
          "finishedAt": {
            "type": "string",
            "nullable": true
          },
          "pendingEvents": {
            "type": "integer",
            "description": "Eventos no outbox ainda não publicados na fila da saga"
          }
        }
      }
    }
  }
}